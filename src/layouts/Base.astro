---
import '@fontsource-variable/inter';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import { site } from '../config';

interface Crumb {
  name: string;
  /** Root-relative, with the base already applied (as Astro.url.pathname is). */
  path: string;
}

interface Props {
  /** Under 60 characters, pairing "Nexus" or "Airogine" with what the page is about. */
  title: string;
  /** 70 to 160 characters. */
  description: string;
  /** The page's main visual once it exists; falls back to the brand card (1200×630). */
  ogImage?: string;
  ogImageAlt?: string;
  /** 'article' for documentation and legal pages. */
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** The trail below Home, for the breadcrumb structured data. */
  breadcrumbs?: Crumb[];
  /** Further schema.org nodes for this page, added to the page's structured data graph. */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  ogImageAlt = 'Nexus by Airogine: your whole plant, in one browser tab. SCADA, HMI and historian in one gateway.',
  ogType = 'website',
  noindex = false,
  breadcrumbs = [],
  schema = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL(url(ogImage), Astro.site);
const home = new URL(url('/'), Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;

// Who publishes the site, on every page; the breadcrumb trail and any page-specific
// nodes (the product, an article) join it in one graph.
const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${home}#organization`,
    name: site.company,
    url: home,
    ...(site.profiles.length ? { sameAs: site.profiles } : {}),
  },
  {
    '@type': 'WebSite',
    '@id': `${home}#website`,
    name: site.company,
    url: home,
    inLanguage: 'en',
    publisher: { '@id': `${home}#organization` },
  },
  ...(breadcrumbs.length
    ? [
        {
          '@type': 'BreadcrumbList',
          itemListElement: [{ name: 'Home', path: url('/') }, ...breadcrumbs].map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: abs(crumb.path),
          })),
        },
      ]
    : []),
  ...schema,
];
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#07090e" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.company} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    {ogImage === '/og/default.png' && <meta property="og:image:width" content="1200" />}
    {ogImage === '/og/default.png' && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Respect reduced motion for looping product clips.
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('video[autoplay]').forEach((v) => {
          v.autoplay = false;
          v.pause();
          v.controls = true;
        });
      }
    </script>
  </body>
</html>
