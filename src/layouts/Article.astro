---
// A resource article: eyebrow, headline, standfirst and byline, an optional
// wide visual, then readable long-form text. Ends with a demo prompt.
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { resources, formatDate } from '../data/resources';
import { site } from '../config';
import { url } from '../lib/url';

interface Props {
  /** The <title>: under 60 characters. */
  title: string;
  description: string;
  headline: string;
  standfirst: string;
  eyebrow: string;
  ogImage?: string;
  ogImageAlt?: string;
  ctaHeadline?: string;
  ctaBody?: string;
}

const { title, description, headline, standfirst, eyebrow, ogImage, ogImageAlt, ctaHeadline, ctaBody } = Astro.props;
const path = Astro.url.pathname;
const entry = resources.find((r) => url(r.href) === path)!;
const home = new URL(url('/'), Astro.site).href;

const schema = [
  {
    '@type': 'Article',
    headline,
    description,
    url: new URL(path, Astro.site).href,
    inLanguage: 'en',
    datePublished: entry.published,
    ...(ogImage ? { image: new URL(url(ogImage), Astro.site).href } : {}),
    about: { '@type': 'SoftwareApplication', name: site.product, '@id': `${home}#nexus` },
    author: { '@id': `${home}#organization` },
    publisher: { '@id': `${home}#organization` },
    isPartOf: { '@id': `${home}#website` },
  },
];
---

<Base
  title={title}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  breadcrumbs={[
    { name: 'Resources', path: url('/resources/') },
    { name: entry.title, path },
  ]}
  schema={schema}
>
  <article>
    <header class="page-hero article-head">
      <div class="container article-narrow">
        <p class="eyebrow"><a href={url('/resources/')}>Resources</a> · {eyebrow}</p>
        <h1>{headline}</h1>
        <p class="lead">{standfirst}</p>
        <p class="article-meta">
          <span>By the {site.company} team</span>
          <time datetime={entry.published}>{formatDate(entry.published)}</time>
          <span>{entry.minutes} min read</span>
        </p>
      </div>
    </header>

    {
      Astro.slots.has('visual') && (
        <div class="container article-visual">
          <slot name="visual" />
        </div>
      )
    }

    <div class="container article-narrow article-body">
      <slot />
    </div>
  </article>

  <CtaBand headline={ctaHeadline} body={ctaBody} />
</Base>

<style>
  .article-narrow {
    max-width: calc(720px + var(--gutter) * 2);
  }
  .article-head .eyebrow a {
    color: inherit;
    text-decoration: none;
  }
  .article-head .eyebrow a:hover {
    text-decoration: underline;
  }
  .article-head h1 {
    font-size: clamp(2rem, 1.4rem + 2.6vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -0.025em;
  }
  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 24px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  @media (min-width: 560px) {
    .article-meta > * + *::before {
      content: '·';
      margin-right: 18px;
      color: var(--border-strong);
    }
  }
  .article-visual {
    max-width: calc(1120px + var(--gutter) * 2);
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  /* Long-form text */
  .article-body {
    padding-bottom: clamp(16px, 4vw, 40px);
    font-size: 1.0625rem;
  }
  .article-body :global(h2) {
    margin-top: 64px;
    font-size: clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .article-body :global(h3) {
    margin-top: 36px;
    font-size: 1.1875rem;
  }
  .article-body :global(p),
  .article-body :global(ul),
  .article-body :global(ol) {
    margin-top: 18px;
    color: var(--text-2);
    line-height: 1.75;
  }
  .article-body :global(h2 + p),
  .article-body :global(h3 + p) {
    margin-top: 14px;
  }
  .article-body :global(ul) {
    padding-left: 22px;
    list-style: disc;
  }
  .article-body :global(li + li) {
    margin-top: 10px;
  }
  .article-body :global(li::marker) {
    color: var(--primary);
  }
  .article-body :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .article-body :global(a:not(.btn):not(.card):not(.text-link)) {
    color: var(--primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .article-body :global(figure) {
    margin: 36px 0;
  }
  .article-body :global(figcaption) {
    margin-top: 12px;
    color: var(--text-2);
    font-size: 0.875rem;
    text-align: center;
  }
  .article-body :global(.pull) {
    margin: 44px 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid transparent;
    border-image: var(--grad) 1;
    color: var(--text);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
  }
</style>
