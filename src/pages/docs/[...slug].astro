---
import { getCollection, render } from 'astro:content';
import Docs from '../../layouts/Docs.astro';
import { docsOrder } from '../../data/docs';

export async function getStaticPaths() {
  const entries = await getCollection('docs');
  // Every page is in the sidebar, and every sidebar entry has a page.
  const listed = new Set(docsOrder.map((page) => page.slug));
  const unlisted = entries.filter((entry) => !listed.has(entry.id)).map((entry) => entry.id);
  const missing = [...listed].filter((slug) => !entries.some((entry) => entry.id === slug));
  if (unlisted.length || missing.length) {
    throw new Error(`Docs sidebar (src/data/docs.ts) out of step - not listed: ${unlisted.join(', ') || 'none'}; no file: ${missing.join(', ') || 'none'}`);
  }
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<Docs title={entry.data.title} description={entry.data.description} slug={entry.id} headings={headings}>
  <h1>{entry.data.title}</h1>
  <p class="docs-lead">{entry.data.description}</p>
  <div class="docs-prose">
    <Content />
  </div>
</Docs>
