---
// Airogine's terms of use for this website (not the Nexus license agreement).
// Holds the trademark notice that used to sit in the footer. Needs legal review.
import Legal from '../layouts/Legal.astro';
import LegalContact from '../components/LegalContact.astro';
import { site } from '../config';
import { url } from '../lib/url';

const state = site.legal.state;
---

<Legal
  title="Terms of use"
  description="The terms for using the Airogine website and the Nexus documentation on it: permitted use, intellectual property, trademarks, disclaimers and governing law."
  updated={site.legal.termsUpdated}
>
