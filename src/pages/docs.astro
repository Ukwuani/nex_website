---
// Placeholder until the public documentation has a home (open question).
// Point site.docsUrl in src/config.ts at the real docs and delete this page.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---

<Base title="Documentation: Nexus IIoT" description="Nexus documentation." noindex>
  <section class="page-hero">
    <div class="container prose">
      <p class="eyebrow">Docs</p>
      <h1>The documentation is on its way.</h1>
      <p class="lead">
        The public docs, including the deployment guide, are being prepared. Until they are published, these pages cover
        the technical detail, and a demo covers the rest.
      </p>
      <ul class="check-list" style="margin-top: 32px">
        <li>
          <Icon name="network" />
          <p><a href={url('/how-it-works/')}>How it works</a>: architecture, installation and moving between gateways.</p>
        </li>
        <li>
          <Icon name="shield-check" />
          <p><a href={url('/security/')}>Security and reliability</a>: sign-in, roles, transport, audit and redundancy.</p>
        </li>
        <li>
          <Icon name="plug" />
          <p><a href={url('/connectivity/')}>Connectivity</a>: protocols, address formats and scan classes.</p>
        </li>
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={url('/demo/')}>Book a demo</a>
      </div>
    </div>
  </section>
</Base>
