---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found: Nexus IIoT" description="This page doesn't exist." noindex>
  <section class="page-hero">
    <div class="container prose">
      <p class="eyebrow mono">404</p>
      <h1>This page doesn't exist.</h1>
      <p class="lead">It may have moved, or the link may be wrong.</p>
      <div class="actions">
        <a class="btn btn-primary" href={url('/')}>Go to the home page</a>
        <a class="btn btn-secondary" href={url('/demo/')}>Book a demo</a>
      </div>
    </div>
  </section>
</Base>
