---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  id?: string;
  center?: boolean;
}

const { eyebrow, title, lead, id, center = false } = Astro.props;
---

<div class:list={['section-head', { center }]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>
