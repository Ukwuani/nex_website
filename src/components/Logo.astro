---
// The Nexus mark: an "N" drawn as two nodes joined by a link, on the brand
// gradient with an 8 px corner radius (at 32 px). This is a redraw from the
// brief's description; swap in the paths from the app's Logo.tsx / favicon.svg
// so the site matches the product exactly. Keep public/favicon.svg in step.

interface Props {
  size?: number;
}

const { size = 32 } = Astro.props;
const id = `nx-grad-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#6366f1"></stop>
      <stop offset="0.5" stop-color="#3b82f6"></stop>
      <stop offset="1" stop-color="#22d3ee"></stop>
    </linearGradient>
  </defs>
  <rect width="32" height="32" rx="8" fill={`url(#${id})`}></rect>
  <path d="M10 23.5V9.5L22 22.5V8.5" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" stroke-opacity="0.92"></path>
  <circle cx="10" cy="9.5" r="3" fill="#fff"></circle>
  <circle cx="22" cy="22.5" r="3" fill="#fff"></circle>
</svg>
